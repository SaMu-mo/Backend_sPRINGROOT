generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id        Int       @id @default(autoincrement())
  titulo    String
  artista   String
  anio      Int
  canciones Cancion[]
}

model Cancion {
  id       Int    @id @default(autoincrement())
  titulo   String
  duracion Int
  albumId  Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
}